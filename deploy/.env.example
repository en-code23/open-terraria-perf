# ---- Open-Terraria Server-Einstellungen (kopieren nach deploy/.env) ----

# Domain für HTTPS (DNS muss auf den Server zeigen), z. B. terraria.example.org
# Ohne Domain: ":80" (dann nur http://<server-ip>/)
SITE_ADDRESS=:80

# Passwortschutz für die Spielseite (empfohlen — enthält Original-Terraria-Grafiken).
# Hash erzeugen:  docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'DEIN-PASSWORT'
# (in .env jedes $ im Hash verdoppeln: $$)
AUTH_MODE=basic
SITE_USER=spieler
SITE_PASSWORD_HASH=

# ---- optionaler kleiner Terraria-Server (Profil „terraria“) ----
# Einschalten:  COMPOSE_PROFILES=terraria
COMPOSE_PROFILES=
TERRARIA_NAME=Open-Terraria Server
TERRARIA_WORLD_NAME=OpenTerraria
# 1 = klein, 2 = mittel, 3 = groß
TERRARIA_WORLD_SIZE=1
TERRARIA_MAX_PLAYERS=3
TERRARIA_PASSWORD=
TERRARIA_MEMORY=1g
# 127.0.0.1 = nur über das Spiel im Browser; 0.0.0.0 = auch echtes Terraria / iPhone-App über Port 7777
TERRARIA_PUBLIC_BIND=127.0.0.1

# ---- Brücke ----
# 1 = Spieler dürfen über den Browser auch fremden Servern im Internet beitreten
ALLOW_PUBLIC_SERVERS=0
# weitere feste Server, z. B. "Freunde=terraria.freund.de:7777"
EXTRA_SERVERS=
MAX_CONNECTIONS=12
